;; lib.em — shared helpers for server configuration (generated by Emily)
;; https://github.com/Julia-b-work/emily-language

(def tz "America/New_York")
(def puid-pgid {:PUID 1000 :PGID 1000})

;; Standard linuxserver.io service skeleton: name, image, env, restart policy.
(def lscr (fn (name image)
  {:container_name name
   :image image
   :environment (merge puid-pgid {:TZ tz})
   :restart "unless-stopped"}))

;; host:container port mapping string
(def pmap (fn (p) (concat (show p) ":" (show p))))
